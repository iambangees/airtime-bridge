# Airtime Bridge environment — copy to .env.local (and into Vercel at deploy)
# Supabase (orders database): create a project, run supabase/schema.sql, then:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Monnify (Developers -> API Keys & Contract in the dashboard). Sandbox keys start MK_TEST_
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
# VTpass (API keys from the dashboard; sandbox: https://sandbox.vtpass.com/api)
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
# Optional VTpass sandbox fallback auth (email/password basic auth):
VTPASS_USERNAME=
VTPASS_PASSWORD=
# Cron sweep protection + order cap
CRON_SECRET=
MAX_ORDER_AMOUNT=5000

# Phase 3 hardening (all optional, defaults shown)
# MAX_ORDERS_PER_PHONE_DAY=10
# MAX_AMOUNT_PER_PHONE_DAY=20000
# MAX_ORDERS_PER_HOUR=60
# LOW_BALANCE_THRESHOLD=2000
# RESEND_API_KEY=
# ALERT_EMAIL=
# RESEND_FROM=Airtime Bridge <onboarding@resend.dev>
